# Postgres connection string (Neon or equivalent serverless-compatible provider).
# See tech-stack.md's Data layer section.
DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# LLM model used by the Assessment-Generation Agent, called through ADK's
# LiteLlm wrapper so the provider stays a runtime config value (research.md §2).
# Default per research.md §2: Anthropic Claude Sonnet via LiteLLM.
ASSESSMENT_GEN_MODEL=anthropic/claude-sonnet-4-5
ANTHROPIC_API_KEY=

# Langfuse tracing (tech-stack.md's Observability section, FR-014).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Grading Agent A2A endpoint (spec 007 research.md §2) -- the Grading
# Agent's own, separately-deployed Vercel project, e.g.
# https://cognivo-grading-agent.vercel.app or http://localhost:8001 when
# running `grading-agent/` locally via uvicorn (quickstart.md).
GRADING_AGENT_URL=

# LLM model used by the pre-grading moderation check (spec 007 FR-012,
# research.md §5) -- deliberately Haiku, not the Sonnet default above.
MODERATION_MODEL=anthropic/claude-haiku-4-5
