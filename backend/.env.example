# Postgres connection string (Neon or equivalent serverless-compatible provider).
# See tech-stack.md's Data layer section.
DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# LLM model used by the Assessment-Generation Agent, called through ADK's
# LiteLlm wrapper so the provider stays a runtime config value (research.md §2).
# Default per research.md §2: Anthropic Claude Sonnet via LiteLLM.
ASSESSMENT_GEN_MODEL=anthropic/claude-sonnet-4-5
ANTHROPIC_API_KEY=

# Langfuse tracing (tech-stack.md's Observability section, FR-014).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Grading Agent A2A endpoint (spec 007 research.md §2) -- the Grading
# Agent's own, separately-deployed Vercel project, e.g.
# https://cognivo-grading-agent.vercel.app or http://localhost:8001 when
# running `grading-agent/` locally via uvicorn (quickstart.md).
GRADING_AGENT_URL=

# Shared secret sent as `X-Grading-Agent-Secret` on every call to the
# Grading Agent above -- must match GRADING_AGENT_SHARED_SECRET set on
# the grading-agent/ deployment itself (PR #18 review: the Grading
# Agent's endpoint is public, so it authenticates every request rather
# than trusting network-level isolation).
GRADING_AGENT_SHARED_SECRET=

# Optional. Vercel's own Deployment Protection (Vercel Authentication)
# sits in front of non-production deployments by default -- a separate,
# earlier gate than GRADING_AGENT_SHARED_SECRET above. Only needed if
# the grading-agent/ deployment target has that protection enabled;
# leave unset otherwise. Must match the "Protection Bypass for
# Automation" secret generated in that Vercel project's Deployment
# Protection settings, sent as `x-vercel-protection-bypass`.
GRADING_AGENT_VERCEL_BYPASS_SECRET=

# LLM model used by the pre-grading moderation check (spec 007 FR-012,
# research.md §5) -- deliberately Haiku, not the Sonnet default above.
MODERATION_MODEL=anthropic/claude-haiku-4-5

# Signing secret for guardian/instructor session JWTs (spec 010
# research.md §1) -- stateless auth, no server-side session store.
# Generate a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET`
# when it triggers GET /api/cron/reset-demo-data on schedule
# (vercel.json, tech-stack.md's Demo account reset row, T057b) -- set
# this in the Vercel project's own environment variables so Vercel's
# cron dispatcher supplies it automatically; also needed locally to
# trigger a reset manually. Generate a long random value, e.g.
# `openssl rand -hex 32`.
CRON_SECRET=
